---
/*
  Apple's "Download on the App Store" badge (black, US-UK; the same file as softfill-web's), linking to the listing.
  Used as supplied, at least 40px tall, with clear space round it, per Apple's badge guidelines.
*/
const listing = 'https://apps.apple.com/app/id6825225682';

interface Props {
  height?: number;
}

const { height = 56 } = Astro.props;
---

<a href={listing} class="store">
  <img
    src="/app-store-badge.svg"
    alt="Download on the App Store"
    height={height}
    width={Math.round((height * 119.66407) / 40)}
  />
</a>

<style>
  .store {
    display: inline-block;
    line-height: 0;
    border-radius: 9px;
  }
  .store img { display: block; }
</style>
