---
interface Props {
  q: string;
}

const { q } = Astro.props;
---

<details>
  <summary class="ui">
    <span>{q}</span>
    <span class="plus" aria-hidden="true">+</span>
  </summary>
  <div class="answer">
    <slot />
  </div>
</details>

<style>
  details {
    background: var(--card);
    box-shadow: 0 0 0 3px var(--ink);
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px 22px;
    font-size: 23px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }

  .plus {
    flex: none;
    font-size: 28px;
    line-height: 1;
  }
  details[open] .plus { transform: rotate(45deg); }

  .answer {
    padding: 0 22px 22px;
    font-size: 18px;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
</style>
