---
import '@fontsource/press-start-2p/latin-400.css';
import '@fontsource/pixelify-sans/latin-500.css';
import '@fontsource/pixelify-sans/latin-ext-500.css';
import '@fontsource/pixelify-sans/latin-700.css';
import '@fontsource/pixelify-sans/latin-ext-700.css';
import '@fontsource/nunito/latin-500.css';
import '@fontsource/nunito/latin-ext-500.css';
import '@fontsource/nunito/latin-700.css';
import '@fontsource/nunito/latin-ext-700.css';
import '@fontsource/nunito/latin-800.css';
import '@fontsource/nunito/latin-ext-800.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Header, { type Page } from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  page: Page;
  title: string;
  description: string;
}

const { page, title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// The home page is mostly night bands; Support and Privacy sit on cream.
const tone = page === 'home' ? 'night' : 'cream';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2A2150" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Where's My Crown?" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-image.jpg', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="552" />
    <meta property="og:image:alt" content="The title screen of Where's My Crown?: the princess, the dragon and the castle" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Safari's Smart App Banner, linking to the App Store listing. -->
    <meta name="apple-itunes-app" content="app-id=6825225682" />
  </head>
  <body class={`page-${tone}`}>
    <Header page={page} />
    <main>
      <slot />
    </main>
    <Footer page={page} />
  </body>
</html>
