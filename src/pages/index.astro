---
import Base from '../layouts/Base.astro';
import Sprite from '../components/Sprite.astro';
import AppStoreButton from '../components/AppStoreButton.astro';

// The little sister's default dress on the site is blue, so she stands out
// next to the princess.
const sisterBlue = { p: '#4A90E2', P: '#2C5AA0', w: '#DCEBFF' };

// iPad screenshots from the game (4:3, like the slots).
const peeks = [
  { src: '/screens/maze.png', alt: 'A spring maze with pink blossom hedges, the princess, the dragon and the crown', caption: 'Tap anywhere on the path and the princess walks there.' },
  { src: '/screens/unicorn.png', alt: 'The princess riding the unicorn through a snowy winter maze, leaving a trail of hearts', caption: 'Beat the dragon, then ride the unicorn to the crown.' },
  { src: '/screens/dress-up.png', alt: 'The dress-up screen with the princess and her little sister', caption: 'Pick her dress, her hair, and bring her little sister along.' },
];

const features = [
  { title: 'Big, easy controls', text: 'Tap where to go, swipe, or use the big arrow buttons. No fiddly timing needed.', accent: 'var(--gold)' },
  { title: 'Reads out loud', text: "Every message is spoken, so children who can't read yet can play on their own.", accent: 'var(--pink)' },
  { title: 'Gentle, never scary', text: 'If the dragon puffs fire, the princess simply hops back to a safe spot and tries again.', accent: 'var(--sky)' },
  { title: 'Dress up', text: 'Choose her dress and hair colour, and bring a little sister who follows her around.', accent: 'var(--mint)' },
  { title: 'Twelve mazes', text: 'From the lilac castle through a flower garden, a crystal cave and all four seasons, then home again.', accent: 'var(--gold)' },
  { title: 'Stars to collect', text: 'Keep your hearts to earn up to three stars in each maze, then come back to beat your best.', accent: 'var(--pink)' },
];

const helpers = [
  {
    sprite: 'unicorn_a',
    name: 'Unicorn',
    text: 'Gallops to the dragon and chases it away in a puff of smoke, leaving hearts or a rainbow behind. Then the princess can climb on and ride.',
    tint: '#FFD6E2',
    width: 140,
  },
  {
    sprite: 'fairy',
    name: 'Fairy',
    text: 'Flies over the walls and sprinkles the dragon to sleep, then flutters along beside the princess in a cloud of fairy dust.',
    tint: '#C9F3FF',
    width: 112,
    glow: true,
  },
  {
    sprite: 'owl',
    name: 'Owl',
    text: 'Flies straight to the crown and lights up the way there with a trail of marching purple arrows.',
    tint: '#F6E2B8',
    width: 112,
  },
  {
    sprite: 'bunny',
    name: 'Bunny',
    text: 'Gives the princess three big hops: bump into a wall and she jumps right over it in a puff of dust.',
    tint: '#FFE3EF',
    width: 112,
  },
  {
    sprite: 'kitten',
    name: 'Kitten',
    text: 'Teaches her to tiptoe. For a little while she can sneak right past the dragon, leaving tiny paw prints.',
    tint: '#FFE0C2',
    width: 112,
  },
  {
    sprite: 'turtle',
    name: 'Turtle',
    text: 'Lends her a shiny green shell that blocks one dragon puff, then cracks. No heart lost!',
    tint: '#D8F5C9',
    width: 112,
  },
] as const;

const promises = [
  { title: 'No ads, ever.', text: 'Not even optional ones.' },
  { title: 'No accounts and no personal data.', text: 'Nothing is collected or tracked. Progress and settings stay on your device.' },
  { title: 'Grown-up gate.', text: "Purchases, settings and links sit behind a quick question only an adult can answer. Your child never sees a price or a store." },
  { title: 'Free to play, Royal Pass optional.', text: 'Every maze is free, and the unicorn comes along free once a day. One purchase, the Royal Pass, brings every helper any time. No subscription.' },
];
---

<Base
  page="home"
  title="Where's My Crown? – A Princess Maze Adventure"
  description="Where's My Crown? A gentle 16-bit princess maze adventure for little kids on iPhone and iPad."
>
  <section class="night">
    <div class="container hero">
      <div class="hero-copy">
        <p class="pixel kicker">A PRINCESS MAZE ADVENTURE</p>
        <h1 class="title">WHERE'S MY CROWN?</h1>
        <p class="lead">
          The princess has lost her crown somewhere in the maze. Help her find it, tiptoe past the
          fire-puffing dragon, and make friends with a unicorn, a fairy, a wise old owl and more along the way.
        </p>
        <p class="ages">A gentle 16-bit maze game for little adventurers, about 3 to 6.</p>
        <div class="cta">
          <AppStoreButton />
          <a href="#parents" class="ui">Info for parents</a>
        </div>
      </div>
      <div class="stage" aria-hidden="true">
        <div class="cast">
          <Sprite name="princess_crowned" class="bob princess" />
          <Sprite name="little_sister" palette={sisterBlue} class="bob sister" />
          <Sprite name="dragon_a" class="dragon" />
        </div>
        <div class="wall"></div>
      </div>
    </div>
  </section>

  <section class="cream">
    <div class="container story">
      <Sprite name="heart" class="heart" />
      <div class="story-copy">
        <h2 class="section-title">A game idea by Nati, age 4</h2>
        <p>
          Nati came up with the princess, the maze and the dragon who puffs fire. Her dad built the game
          around her ideas, one by one: the unicorn that leaves a trail of hearts, the crown the princess
          has to find, and the little sister who follows her everywhere.
        </p>
      </div>
    </div>
  </section>

  <section class="night" aria-labelledby="see-h">
    <div class="container band">
      <h2 id="see-h" class="section-title">Take a peek</h2>
      <div class="grid peeks">
        {peeks.map((p) => (
          <figure>
            <img class="shot" src={p.src} alt={p.alt} width="2752" height="2064" loading="lazy" decoding="async" />
            <figcaption>{p.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="cream" aria-labelledby="why-h">
    <div class="container band">
      <h2 id="why-h" class="section-title">Made for little hands</h2>
      <div class="grid features">
        {features.map((f) => (
          <div class="feature" style={`--accent: ${f.accent}`}>
            <h3 class="ui">{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="helpers" class="night" aria-labelledby="helpers-h">
    <div class="container band">
      <div class="intro">
        <h2 id="helpers-h" class="section-title">Bring a helper</h2>
        <p>Each helper has its own way of dealing with the dragon, and its own sparkly trail.</p>
      </div>
      <div class="grid helpers">
        {helpers.map((h) => (
          <div class="helper" style={`--tint: ${h.tint}`}>
            <Sprite
              name={h.sprite}
              label={`The ${h.name.toLowerCase()}`}
              class:list={[{ glow: 'glow' in h }]}
              style={`width: ${h.width}px`}
            />
            <h3 class="ui">{h.name}</h3>
            <p>{h.text}</p>
          </div>
        ))}
      </div>
      <p class="more">The unicorn comes along for free once a day. The Royal Pass brings every helper, any time.</p>
    </div>
  </section>

  <section id="parents" class="cream" aria-labelledby="parents-h">
    <div class="container parents">
      <div class="parents-copy">
        <h2 id="parents-h" class="section-title">For parents</h2>
        <p class="parents-lead">
          We're parents too. Where's My Crown? is built to be a safe, calm place for small children to play.
        </p>
        <p>Questions? Visit <a href="/support">Support</a> or read our <a href="/privacy">Privacy Policy</a>.</p>
      </div>
      <ul>
        {promises.map((p) => (
          <li>
            <Sprite name="check" palette={{ o: '#2E8C3D' }} class="check" />
            <span><strong>{p.title}</strong> {p.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="download" class="night">
    <div class="container download">
      <h2 class="title">Ready to find the crown?</h2>
      <p>Free on iPhone and iPad.</p>
      <AppStoreButton />
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    padding-top: 72px;
    padding-bottom: 88px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 56px;
  }
  .hero-copy {
    flex: 1 1 440px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .kicker { font-size: 14px; line-height: 1.6; color: var(--pink); }
  h1 {
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.25;
    text-shadow: 5px 5px 0 var(--ember);
  }
  .lead {
    font-size: 22px;
    line-height: 1.55;
    color: var(--on-night-lead);
    max-width: 34rem;
    text-wrap: pretty;
  }
  .ages { font-size: 18px; line-height: 1.5; color: var(--on-night-muted); }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin-top: 8px;
  }
  .cta > a.ui { font-size: 20px; color: var(--gold); }

  .stage {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .cast {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 12px;
    max-width: 100%;
  }
  .cast :global(.princess) { width: clamp(80px, 11vw, 128px); }
  .cast :global(.sister) { width: clamp(60px, 8vw, 96px); animation-delay: 0.5s; }
  .cast :global(.dragon) { width: clamp(120px, 16vw, 192px); transform: scaleX(-1); }
  /* A strip of maze wall for the cast to stand on */
  .wall {
    width: 100%;
    max-width: 460px;
    height: 20px;
    background: var(--stone);
    box-shadow: inset 0 -8px 0 var(--stone-deep), 0 4px 0 var(--night-deep);
  }

  /* Nati */
  .story {
    padding-top: 64px;
    padding-bottom: 64px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 40px;
  }
  .story :global(.heart) { width: 96px; flex: none; }
  .story-copy {
    flex: 1 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .story-copy p { font-size: 20px; line-height: 1.6; max-width: 46rem; text-wrap: pretty; }

  /* Shared band layout */
  .band {
    padding-top: 72px;
    padding-bottom: 72px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .grid { display: grid; gap: 24px; }

  /* Screenshots */
  .peeks { grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); }
  figure { display: flex; flex-direction: column; gap: 12px; }
  .shot {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    background: var(--panel);
    box-shadow: 0 0 0 4px var(--panel-line);
  }
  figcaption { font-size: 18px; color: var(--on-night-2); }

  /* Features */
  .features {
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 20px;
  }
  /* Six features: two even rows of three on wide screens. */
  @media (min-width: 900px) {
    .features { grid-template-columns: repeat(3, 1fr); }
  }
  .feature {
    background: var(--card);
    box-shadow: 0 0 0 4px var(--ink), 6px 6px 0 4px var(--accent);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .feature h3 { font-size: 26px; }
  .feature p { font-size: 18px; line-height: 1.55; }

  /* Helpers */
  .intro { display: flex; flex-direction: column; gap: 12px; }
  .intro p { font-size: 20px; line-height: 1.55; color: var(--on-night-2); max-width: 40rem; }
  .helpers { grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); }
  .helper {
    background: var(--panel);
    box-shadow: inset 0 0 0 4px var(--panel-line);
    padding: 28px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }
  .helper :global(.glow) { filter: drop-shadow(0 0 8px var(--sky)); }
  .helper h3 { font-size: 28px; }
  .helper p { font-size: 18px; line-height: 1.55; color: var(--tint); }
  .more { font-size: 18px; color: var(--on-night-muted); }

  /* Parents */
  .parents {
    padding-top: 72px;
    padding-bottom: 72px;
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
  }
  .parents-copy {
    flex: 1 1 340px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 18px;
    line-height: 1.6;
  }
  .parents-lead { font-size: 20px; text-wrap: pretty; }
  ul {
    flex: 1 1 480px;
    min-width: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  li {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    font-size: 19px;
    line-height: 1.55;
  }
  li :global(.check) { width: 28px; flex: none; margin-top: 4px; }

  /* Final call */
  .download {
    padding-top: 80px;
    padding-bottom: 80px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    text-align: center;
  }
  .download h2 { font-size: clamp(18px, 3vw, 30px); line-height: 1.5; }
  .download p { font-size: 20px; color: var(--on-night-2); }
</style>
